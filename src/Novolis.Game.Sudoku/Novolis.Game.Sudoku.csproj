<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Game.Sudoku</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Host-neutral classic Sudoku boards, solving, generation, and difficulty analysis.</Description>
    <RootNamespace>Novolis.Game.Sudoku</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Math.Arrays" />
    <ProjectReference Include="..\Novolis.Game.Procedural\Novolis.Game.Procedural.csproj" />
  </ItemGroup>
</Project>
